% Visible placeholder for facts only you can supply. Delete before sending.
\newcommand{\TODO}[1]{{\color{red}\bfseries [TODO: #1]}}

\urlstyle{same}

% Header
\newcommand{\simpleheader}[2]{%
    \begin{tikzpicture}[remember picture,overlay]

        % Background
        \fill[
            headerColor
        ]
        (current page.north west)
        rectangle
        ([yshift=-2.25cm]current page.north east);

        % Name
        \node[
            anchor=west,
            text=white,
            inner sep=0pt
        ]
        at ([xshift=1.35cm,yshift=-0.85cm]current page.north west)
        {
            \fontsize{27}{31}\selectfont
            \bfseries #1
        };

        % Contact information
        \node[
            anchor=west,
            text=white,
            inner sep=0pt
        ]
        at ([xshift=1.38cm,yshift=-1.65cm]current page.north west)
        {
            \fontsize{10.5}{13}\selectfont
            \begingroup\hypersetup{urlcolor=white}#2\endgroup
        };



    \end{tikzpicture}
    \vspace{1cm}
}

% Compact visual skill band: searchable text, no bars/charts.
\newcommand{\skillband}[2]{%
  {\color{textColor}
   \textbf{\small #1:} {\small #2}
  }\par
  \vspace{2pt}%
}
% =========================================================
% COMPANY / EXPERIENCE BLOCK
% =========================================================

% Company line sits directly below the grouped job titles.
% #1 = company
% #2 = employment type / location / other metadata
\newcommand{\companyheading}[3]{%
{\fontsize{8.2}{10}\selectfont
 \color{metaColor}
 \textbf{#1}%
 \hspace{4pt}
 \textbar
 \hspace{4pt}
 #2%
 \hfill
 #3%
}\par
}

% Promotion marker. Deliberately larger and darker than a footnote: this is a
% positive signal a recruiter should catch in a 6-second skim, and it also
% gives ATS parsers a single line containing both titles, which helps when a
% parser would otherwise attribute only one title to the employer.
\newcommand{\promotion}[1]{%
  {\fontsize{8.2}{10}\selectfont
   \itshape
   \color{metaColor}
   #1%
  }\par
  \vspace{2pt}%
}

% Highlight for a key outcome inside a bullet.
% Bold is purely visual -- it extracts as identical plain text, so this is
% neutral for ATS and helps a human skimming. Use sparingly: if more than
% about one line per role is bold, nothing stands out any more.
% To turn all highlighting off, change the body to just #1.
\newcommand{\metric}[1]{\textbf{#1}}
% Concise overview of the role, including relevant technical context.
\newcommand{\companysummary}[1]{%
  \vspace{2.5pt}%
  {\fontsize{8.2}{10}\selectfont
   \color{textColor}
   #1%
  }\par
  \vspace{4.5pt}%
}
% Job title line.
% NOTE: \addfontfeatures{LetterSpace=0.12} was removed here. Tracking is
% implemented as inter-glyph kerns, and weaker ATS parsers turn those into
% word breaks -- "Technical Lead" can extract as "T e c h n i c a l".
% The job title is the single most important string on the CV to get right.
% #1 = title
% #2 = dates
\newcommand{\role}[2]{%
  \noindent
  \makebox[\linewidth][l]{%
    {\fontsize{11}{15}\selectfont
     \bfseries
     \color{titleBackColor}
     #1}%
    \hfill
    {\fontsize{8.4}{15}\selectfont
     \color{mutedColor}
     \bfseries
     #2}
  }%
  \par
  \vspace{3.2pt}
}

% Company block:
% #1 = company
% #2 = company metadata
% #3 = grouped role lines
% #4 = optional metadata line
% #5 = bullet content
%
% The old promotion line is deliberately not rendered.
% The company name now appears immediately underneath the titles.
\newcommand{\companyblock}[5]{%
  \begin{minipage}[t]{\linewidth}

    #3

    \vspace{2.4pt}
    \companyheading{#1}{#2}{\if\relax\detokenize{#4}\relax
    \else
      {\fontsize{7.9}{9.5}\textit{#4}}\par
    \fi}
    \vspace{4pt}
    #5

  \end{minipage}\par % end the paragraph so the gap below is discardable at a page break
  \vspace{7pt}
}

% Experience bullets.
% The right margin keeps the text measure deliberately narrower.
\newenvironment{jobbullets}{%
  \begin{itemize}[
    leftmargin=0.43cm,
    rightmargin=1.25cm,
    label=\textbullet,
    itemsep=2.5pt,
    topsep=2.2pt,
    parsep=0pt,
    partopsep=0pt
  ]
  \fontsize{8.8}{11}\selectfont
}{%
  \end{itemize}
}


\newcommand{\education}[5]{%
  \begin{minipage}[t]{\linewidth}
    \begin{tabularx}{\linewidth}{@{}X r@{}}
      \textbf{\small #1} & {\footnotesize\color{mutedColor}#2}\\
    \end{tabularx}
    {\small #3}\par
    {\footnotesize\color{mutedColor}#4}\par
    {\footnotesize #5}
  \end{minipage}
  \vspace{7pt}
}

\newcommand{\sidebarSection}[1]{%
  {\small\bfseries\color{titleBackColor}#1}\par
  \vspace{2pt}\color{titleBackColor}\rule{\linewidth}{0.5pt}\par\vspace{3pt}
}
